# Copy to .streamlit/secrets.toml (git-ignored), or set the same names as environment variables.
# Without PARADIME_API_SECRET the app starts in demo mode and replays recorded answers.

# --- Paradime API -------------------------------------------------------------------
# Create the key under Settings > API keys and give it access to the DinoAI Agents API.
# The GraphQL endpoint is shown next to the key. It is region-specific.
PARADIME_API_ENDPOINT = ""
# An account key (prdm_cmp_...) with the workspace uid. Or a legacy workspace key pair: the secret
# here, the key in PARADIME_API_KEY, and no workspace uid.
PARADIME_API_SECRET = ""
PARADIME_WORKSPACE_UID = ""
# Only for legacy workspace keys (key + secret pair):
# PARADIME_API_KEY = ""

# Slug of the programmable agent to run (agent/stakeholder-analyst.yml, once deployed). The agent
# builder shows the slug in its URL: .../agent/builder/edit/<slug>?uuid=... An agent created in the
# UI gets a generated slug, for example "stakeholder-5029ee". Empty: the workspace's default agent.
DINOAI_AGENT = ""

# Slug of a model family (Agent builder > Model), for example a Fast preset, to make
# answers quicker. Empty: the agent's own family. An unknown slug falls back to the default.
DINOAI_MODEL_FAMILY = ""

# --- Reports ("Report a problem") ---------------------------------------------------
# A reader's report goes to the stakeholder-analyst agent, which hands it to the feedback
# agent in its agents_squad. Deploy agent/analytics-feedback.yml too, and set LINEAR_API_KEY
# in the workspace's agent environment variables.
# The feedback agent's slug, for example "analytics-fe-98e818" for an agent created in the UI.
ANALYST_FEEDBACK_AGENT = "analytics-feedback"
ANALYST_FEEDBACK_TEAM = "DNA"
# The person who gets each report. Empty: the issue is unassigned, for the team to triage.
ANALYST_FEEDBACK_ASSIGNEE = ""

# --- App ----------------------------------------------------------------------------
ANALYST_TITLE = "Ask your data"

# Sent to the agent at the start of every conversation: glossary, fiscal calendar,
# where the governed marts live, which metrics are official.
ANALYST_CONTEXT = """
This workspace holds Formula 1 results from 1950 to 2024, modelled in dbt.
The governed marts are in the BigQuery dataset dbt_prod (fct_ and dim_ models).
"""

ANALYST_STARTER_QUESTIONS = [
  "Which constructors have won the most races since 2014? Also show how wins per season evolved for the top 3.",
  "Zoom in on the 2023 season: give me Red Bull's headline numbers, and show how championship points compare with race wins for the top 10 drivers.",
]

# ANALYST_MODE = "demo"        # force demo mode even with credentials
# ANALYST_POLL_SECONDS = 3     # how often to poll the agent run
# ANALYST_REPLAY_SPEED = 4     # demo mode: replay recorded timings this many times faster
# ANALYST_REPLAY_MIN_STEP = 2  # demo mode: the shortest replay step, in seconds
